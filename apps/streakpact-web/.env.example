NEXT_PUBLIC_STREAKPACT_V2_ADDRESS=
NEXT_PUBLIC_NETWORK_NAME=StudioNet

# Server-only. Create a Pinata key restricted to org:files:write.
PINATA_JWT=

# Required in production: exact HTTPS origin, for example https://streakpact.example.com.
# No path/query. Missing or invalid production origins disable evidence uploads.
STREAKPACT_APP_ORIGIN=
